    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="ManagedCode.LlmTestServer" Version="1.0.5" />
    <PackageVersion Include="ManagedCode.LlmTestServer.Client" Version="1.0.5" />
    <PackageVersion Include="ManagedCode.LlmTestServer.Hosting" Version="1.0.5" />
    <PackageVersion Include="ManagedCode.LlmTestServer.OpenAI" Version="1.0.5" />
    <PackageVersion Include="ManagedCode.MarkdownLd.Kb" Version="0.2.18" />
    <PackageVersion Include="ManagedCode.Storage.Core" Version="10.1.6" />
    <PackageVersion Include="ManagedCode.Storage.FileSystem" Version="10.1.6" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
